# ─────────────────────────────────────────────────────────────────────────────
# Bayut KSA — Talent Acquisition platform
# Copy to .env.local and fill in. Every variable is documented in
# docs/12-environment-variables.md, which is generated from this file and the
# schema in lib/env.ts; nothing here has a production default baked into code.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3400
APP_PORT=3400

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL 16+. The local dev cluster is created by scripts/pg-init.ps1.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55441/bayut_ta
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ── Sessions & secrets ───────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# Rotating this invalidates every signed file URL immediately.
FILE_SIGNING_SECRET=

# ── Authentication ───────────────────────────────────────────────────────────
AUTH_MODE=password            # password | oidc | both
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
# OIDC (AUTH_MODE=oidc|both). Leave blank and the SSO button reports "not configured".
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3400/api/auth/oidc/callback
OIDC_SCOPES=openid email profile

# ── File storage ─────────────────────────────────────────────────────────────
STORAGE_DRIVER=local          # local | s3
STORAGE_LOCAL_ROOT=./.storage
STORAGE_MAX_UPLOAD_MB=25
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Malware scanning ─────────────────────────────────────────────────────────
# clamav | none. With `none`, uploads are accepted and marked scan_skipped, and
# the UI says so rather than claiming a file is clean.
MALWARE_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ── Messaging providers ──────────────────────────────────────────────────────
# Each adapter reports "not configured" when its credentials are absent; nothing
# is ever reported as sent when it was not.
EMAIL_PROVIDER=none           # none | smtp | ses | sendgrid
EMAIL_FROM="Bayut KSA Talent Acquisition <ta@bayut.sa>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SENDGRID_API_KEY=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

WHATSAPP_PROVIDER=none        # none | meta_cloud | twilio
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=

SMS_PROVIDER=none             # none | twilio | unifonic
SMS_FROM=Bayut
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
UNIFONIC_APP_SID=

LINKEDIN_PROVIDER=none        # none | talent_solutions
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_URN=

# ── Calendar ─────────────────────────────────────────────────────────────────
CALENDAR_PROVIDER=none        # none | google | microsoft
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# ── E-signature ──────────────────────────────────────────────────────────────
ESIGN_PROVIDER=none           # none | docusign | dropbox_sign
DOCUSIGN_BASE_URL=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_WEBHOOK_SECRET=

# ── Telephony / voice (AI phone screening) ───────────────────────────────────
VOICE_PROVIDER=none           # none | twilio_voice | vapi
VOICE_FROM_NUMBER=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VOICE_WEBHOOK_SECRET=
VOICE_RECORDING_RETENTION_DAYS=30

# ── HRIS ─────────────────────────────────────────────────────────────────────
HRIS_PROVIDER=none            # none | jisr | workday
HRIS_BASE_URL=
HRIS_API_KEY=
HRIS_WEBHOOK_SECRET=

# ── Assessments ──────────────────────────────────────────────────────────────
ASSESSMENT_PROVIDER=none      # none | thomas | shl | hogan | predictive_index
ASSESSMENT_BASE_URL=
ASSESSMENT_API_KEY=
ASSESSMENT_WEBHOOK_SECRET=

# ── AI (CV reading, Ask AI, call/pitch analysis) ─────────────────────────────
# With no key the platform falls back to its own deterministic local engines and
# labels every result "local rules" rather than pretending Claude read it.
AI_PROVIDER=none              # none | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_MAX_TOKENS=4096

# ── Automation engine / workers ──────────────────────────────────────────────
WORKER_ENABLED=true
WORKER_POLL_MS=2000
WORKER_BATCH=20
WORKER_MAX_ATTEMPTS=6

# ── Data retention ───────────────────────────────────────────────────────────
CANDIDATE_RETENTION_MONTHS=24
AUDIT_RETENTION_MONTHS=84
RECORDING_RETENTION_DAYS=30

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error
LOG_FORMAT=pretty             # pretty | json

# ── Test clock ───────────────────────────────────────────────────────────────
# Lets a request take its "now" from the bayut_ta_clock cookie instead of the
# wall clock, so the visual comparison can hold production still while it
# photographs it. Refused outright when NODE_ENV is production, and never used
# for session expiry. Leave it unset anywhere real.
ALLOW_TEST_CLOCK=1
